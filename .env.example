# Copy this to .env for local development (never commit .env)
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Database — CloudNativePG (local k3d) or postgresql for local dev
DATABASE_URL=postgresql+asyncpg://aegis_app:changeme@localhost:5432/aegis_urban

# AWS / Floci endpoint (in-cluster use http://floci:4566)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# OpenTelemetry (optional — comment out to disable tracing)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
